// Prisma schema for SMA Fuel & Market backend.
// Mirrors the shapes already used by the frontend's src/lib/catalog.ts,
// store-location.ts and orders.ts so the API layer is a drop-in replacement
// for the static data.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  orders Order[]
}

model Department {
  slug           String   @id
  name           String
  blurb          String
  art            String
  hue            Int
  ageRestricted  Boolean  @default(false)

  categories Category[]
  products   Product[]
}

model Category {
  slug           String     @id
  name           String
  art            String
  hue            Int
  departmentSlug String
  department     Department @relation(fields: [departmentSlug], references: [slug])

  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  barcode        String   @unique
  title          String
  brand          String
  departmentSlug String
  department     Department @relation(fields: [departmentSlug], references: [slug])
  categorySlug   String
  category       Category   @relation(fields: [categorySlug], references: [slug])
  unit           String
  price          Decimal  @db.Decimal(10, 2)
  listPrice      Decimal? @db.Decimal(10, 2)
  stock          Int
  lowStockAt     Int
  rating         Float    @default(0)
  reviews        Int      @default(0)
  art            String
  hue            Int
  ageRestricted  Boolean  @default(false)
  tags           String[]
  bullets        String[]
  description    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

model StoreLocation {
  id          String  @id @default(cuid())
  name        String
  address     String
  city        String
  phone       String
  lat         Float
  lng         Float
  radiusMiles Float
  hours       String

  fuelPrices FuelPrice[]
}

model FuelPrice {
  id            String        @id @default(cuid())
  storeId       String
  store         StoreLocation @relation(fields: [storeId], references: [id], onDelete: Cascade)
  grade         String
  price         Decimal       @db.Decimal(10, 2)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  addressId    String?
  address      Address?    @relation(fields: [addressId], references: [id])
  subtotal     Decimal     @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee  Decimal     @default(0) @db.Decimal(10, 2)
  tax          Decimal     @default(0) @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  couponCode   String?
  placedAt     DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}
