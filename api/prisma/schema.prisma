// Prisma schema for SMA Fuel & Market backend.
// Mirrors the shapes already used by the frontend's src/lib/catalog.ts,
// store-location.ts and orders.ts so the API layer is a drop-in replacement
// for the static data.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  passwordResets PasswordResetToken[]
}

/// A single-use, expiring password-reset grant.
///
/// Only a SHA-256 hash of the token is stored. The raw token goes out in the
/// reset link and nowhere else, so a leaked database still cannot be used to
/// reset anyone's password — the same reasoning as never storing raw passwords.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  /// Set the moment the token is spent, so a reset link cannot be replayed.
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  line1     String
  line2     String?
  city      String
  /// Optional: the store delivers inside a single metro area, so checkout does
  /// not ask for a state.
  state     String?
  zip       String
  /// Contact name for the driver at the door.
  recipient String?
  /// Free-text delivery instructions.
  notes     String?
  lat       Float?
  lng       Float?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  orders Order[]
}

/// Departments and categories keep a human-readable `slug` as their primary
/// key rather than a surrogate id — it doubles as the URL segment
/// (`/department/drinks`), so making it numeric would just replace a
/// meaningful path with an opaque one for no benefit.
model Department {
  slug           String   @id
  name           String
  blurb          String
  /// Uploaded artwork for the department circle on the home page. When null
  /// the storefront falls back to the generated `art` + `hue` illustration.
  imageUrl       String?
  art            String
  hue            Int
  ageRestricted  Boolean  @default(false)
  /// Controls the order of the "Shop by department" row.
  sortOrder      Int      @default(0)

  categories Category[]
  products   Product[]
}

model Category {
  slug           String     @id
  name           String
  art            String
  hue            Int
  departmentSlug String
  department     Department @relation(fields: [departmentSlug], references: [slug])

  products Product[]
}

model Product {
  id             Int      @id @default(autoincrement())
  sku            String   @unique
  barcode        String   @unique
  title          String
  brand          String
  departmentSlug String
  department     Department @relation(fields: [departmentSlug], references: [slug])
  categorySlug   String
  category       Category   @relation(fields: [categorySlug], references: [slug])
  unit           String
  price          Decimal  @db.Decimal(10, 2)
  listPrice      Decimal? @db.Decimal(10, 2)
  stock          Int
  lowStockAt     Int
  /// Denormalized average of `productReviews.rating`, recomputed by the
  /// reviews service on every write. Cached here rather than aggregated on
  /// every product read, since the catalogue lists dozens of products at once.
  rating         Float    @default(0)
  /// Denormalized count of `productReviews`, kept in step with `rating`.
  reviews        Int      @default(0)
  /// Uploaded photograph, served from the API's /uploads path. When null the
  /// storefront falls back to the generated `art` + `hue` illustration.
  imageUrl       String?
  art            String
  hue            Int
  ageRestricted  Boolean  @default(false)
  tags           String[]
  bullets        String[]
  description    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems     OrderItem[]
  deals          Deal[]      @relation("DealProducts")
  productReviews Review[]
}

model StoreLocation {
  id          Int     @id @default(autoincrement())
  name        String
  address     String
  city        String
  phone       String
  lat         Float
  lng         Float
  radiusMiles Float
  hours       String

  fuelPrices FuelPrice[]
}

model FuelPrice {
  id            Int           @id @default(autoincrement())
  storeId       Int
  store         StoreLocation @relation(fields: [storeId], references: [id], onDelete: Cascade)
  grade         String
  price         Decimal       @db.Decimal(10, 2)
}

/// A slide in the home page hero carousel.
model HeroSlide {
  id         Int      @id @default(autoincrement())
  sortOrder  Int      @default(0)
  eyebrow    String
  title      String
  blurb      String
  badgeBig   String
  badgeSmall String
  ctaLabel   String
  ctaHref    String
  /// Hex colour driving the badge and the ambient glow behind the art.
  accent     String   @default("#00b04f")
  /// Uploaded artwork for the floating tiles, in display order. Slots left
  /// empty fall back to the generated illustration named in `fallbackArt`.
  tileImages String[]
  /// Glyph keys used when a tile has no uploaded image.
  fallbackArt String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One of the four cards in the grid under the hero.
model ShowcaseCard {
  id        Int      @id @default(autoincrement())
  sortOrder Int      @default(0)
  title     String
  linkLabel String
  linkHref  String
  /// `grid` shows a 2x2 of tiles, `single` one large image.
  variant   String   @default("grid")
  /// Array of { label, href, imageUrl, art, hue }. Held as JSON rather than a
  /// child table because tiles are only ever read and written with their card,
  /// never queried on their own — a relation would add joins and a second
  /// editing surface for no gain.
  tiles     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DealKind {
  flash
  percent
  bogo
  weekend
}

/// A storefront promotion. `products` is a many-to-many because a single deal
/// can cover a bundle (chips + jerky + nuts) and a product can appear in more
/// than one promotion at a time.
model Deal {
  id          Int      @id @default(autoincrement())
  kind        DealKind
  title       String
  detail      String
  /// Percentage off, for `percent`, `flash` and `weekend` deals.
  percentOff  Int?
  /// Hours the promotion runs for. Null means ongoing.
  endsInHours Int?
  /// Promotional artwork, served from the API's /uploads path.
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[] @relation("DealProducts")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id])
  addressId    Int?
  address      Address?    @relation(fields: [addressId], references: [id])
  subtotal     Decimal     @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  deliveryFee  Decimal     @default(0) @db.Decimal(10, 2)
  tax          Decimal     @default(0) @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  couponCode   String?
  placedAt     DateTime    @default(now())

  items OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
}

/// A customer's star rating and comment on a product. One review per
/// customer per product — resubmitting edits it in place rather than piling
/// up duplicates. `verifiedPurchase` is stamped at write time from the
/// customer's real order history, not taken from the request.
model Review {
  id               Int      @id @default(autoincrement())
  productId        Int
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating           Int
  title            String?
  body             String
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, userId])
}
